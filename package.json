{
  "name": "windows-rdp-manager",
  "version": "1.0.0",
  "description": "Gerenciador profissional e seguro de perfis e conexões RDP para Windows com suporte a DPAPI e mstsc.exe nativo",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -r -p \"[{name}]\" -n \"VITE,TSC,ELECTRON\" -c \"blue,yellow,green\" \"vite\" \"tsc -p tsconfig.electron.json -w\" \"wait-on tcp:5173 && electron .\"",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:vite && npm run build:electron",
    "start": "cross-env NODE_ENV=production electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run pack && node -e \"require('fs').rmSync('release/Windows-RDP-Manager-v1.0.0-win-x64.zip', { force: true })\" && node_modules\\7zip-bin\\win\\x64\\7za.exe a -tzip -r -y \"release\\Windows-RDP-Manager-v1.0.0-win-x64.zip\" \".\\release\\win-unpacked\\*\""
  },
  "build": {
    "appId": "br.com.vluzrmos.windowsrdpmanager",
    "productName": "Windows RDP Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    }
  },
  "keywords": [
    "rdp",
    "remote-desktop",
    "windows",
    "mstsc",
    "dpapi",
    "credential-manager"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.2"
  }
}
