{
  "name": "windows-rdp-manager",
  "version": "1.2.0",
  "description": "Gerenciador profissional e seguro de perfis e conexões RDP para Windows com suporte a DPAPI e mstsc.exe nativo",
  "author": "Vagner Luz do Carmo",
  "license": "MIT",
  "homepage": "https://github.com/vluzrmos/windows-rdp-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/vluzrmos/windows-rdp-manager.git"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:native && concurrently -k -r -p \"[{name}]\" -n \"VITE,TSC,ELECTRON\" -c \"blue,yellow,green\" \"vite\" \"tsc -p tsconfig.electron.json -w\" \"wait-on tcp:5173 && electron .\"",
    "build:native": "node scripts/build-rdphost.js",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:native && npm run build:vite && npm run build:electron",
    "start": "cross-env NODE_ENV=production electron .",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "build:number": "node scripts/build-number.js",
    "pack": "npm run build:number && npm run build && node scripts/electron-builder.js --dir",
    "dist:exe": "npm run build:number && npm run build && node scripts/electron-builder.js --win nsis --x64 --publish never",
    "dist:zip": "npm run pack && node scripts/pack-zip.js",
    "dist": "npm run build:number && npm run build && node scripts/electron-builder.js --win nsis --x64 --publish never && node scripts/pack-zip.js"
  },
  "build": {
    "appId": "br.com.vluzrmos.windowsrdpmanager",
    "productName": "Windows RDP Manager",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-native/RdpHost.exe",
        "to": "RdpHost.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Windows RDP Manager",
      "include": "build/installer.nsh",
      "artifactName": "Windows-RDP-Manager-v${version}-build${env.APP_BUILD_NUMBER}-win-x64.${ext}"
    }
  },
  "keywords": [
    "rdp",
    "remote-desktop",
    "windows",
    "mstsc",
    "dpapi",
    "credential-manager"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.2"
  }
}
